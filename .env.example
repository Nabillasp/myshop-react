# URL endpoint REST API backend (Laravel)
# Fallback otomatis ke http://127.0.0.1:8000/api untuk development lokal
VITE_API_URL=http://127.0.0.1:8000/api

# Opsional: URL khusus untuk file media/storage jika menggunakan CDN atau storage eksternal
# Default otomatis mengacu ke: [VITE_API_URL]/storage
# VITE_STORAGE_URL=http://127.0.0.1:8000/storage
